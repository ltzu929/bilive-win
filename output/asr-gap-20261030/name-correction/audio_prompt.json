  "segments": [
    {
      "start": 0.0,
      "end": 0.5199999999999818,
      "text": "我就害怕"
    },
    {
      "start": 0.5199999999999818,
      "end": 1.4600000000000364,
      "text": "我玩第五人格"
    },
    {
      "start": 1.4600000000000364,
      "end": 2.2999999999999545,
      "text": "我都有点害怕"
    },
    {
      "start": 2.2999999999999545,
      "end": 2.8599999999999,
      "text": "你晓得不"
    },
    {
      "start": 2.8599999999999,
      "end": 4.3599999999999,
      "text": "而且第五人格怎么个事呢"
    },
    {
      "start": 4.3599999999999,
      "end": 6.039999999999964,
      "text": "它给人很大的压力啊"
    },
    {
      "start": 6.039999999999964,
      "end": 7.839999999999918,
      "text": "当我跟一堆不熟的人"
    },
    {
      "start": 7.839999999999918,
      "end": 9.319999999999936,
      "text": "那些人都是咩栗老师的朋友"
    },
    {
      "start": 9.319999999999936,
      "end": 10.220000000000027,
      "text": "但他们不是我的朋友"
    },
    {
      "start": 10.220000000000027,
      "end": 11.419999999999845,
      "text": "我跟他们根本就不认识"
    },
    {
      "start": 11.419999999999845,
      "end": 12.740000000000009,
      "text": "然后我加入了他们的那个群"
    },
    {
      "start": 12.740000000000009,
      "end": 13.980000000000018,
      "text": "然后我们一起玩了第五人格"
    },
    {
      "start": 13.980000000000018,
      "end": 14.839999999999918,
      "text": "然后我走进去之后"
    },
    {
      "start": 14.839999999999918,
      "end": 16.8599999999999,
      "text": "我一进去就被那个屠夫打倒"
    },
    {
      "start": 16.8599999999999,
      "end": 17.75999999999999,
      "text": "抓到了椅子上面"
    },
    {
      "start": 17.75999999999999,
      "end": 18.839999999999918,
      "text": "然后我就死了"
    },
    {
      "start": 19.720000000000027,
      "end": 21.139999999999873,
      "text": "我让他们来救我吧"
    },
    {
      "start": 21.139999999999873,
      "end": 21.639999999999873,
      "text": "我又不好意思"
    },
    {
      "start": 21.639999999999873,
      "end": 23.659999999999854,
      "text": "因为你救完我之后我下一秒又会被抓"
    },
    {
      "start": 23.659999999999854,
      "end": 24.659999999999854,
      "text": "我又不希望你们来救我"
    },
    {
      "start": 24.659999999999854,
      "end": 25.700000000000045,
      "text": "但是如果你们不来救我的话"
    },
    {
      "start": 25.700000000000045,
      "end": 28.24000000000001,
      "text": "这一整把里面我的游戏体验只有两分钟"
    },
    {
      "start": 28.659999999999854,
      "end": 30.3599999999999,
      "text": "所以这个游戏对我的意义到底是什么"
    },
    {
      "start": 31.940000000000055,
      "end": 33.72000000000003,
      "text": "就很难搞啊对吧"
    },
    {
      "start": 34.200000000000045,
      "end": 35.819999999999936,
      "text": "压力太大了心理压力"
    },
    {
      "start": 35.819999999999936,
      "end": 36.899999999999864,
      "text": "就你别救我了"
    },
    {
      "start": 36.899999999999864,
      "end": 39.159999999999854,
      "text": "就我一旦被抓我就会说求你了别救我了"
    },
    {
      "start": 39.159999999999854,
      "end": 40.83999999999992,
      "text": "你救我了我一会又被抓了"
    },
    {
      "start": 40.83999999999992,
      "end": 43.27999999999997,
      "text": "或者说你救我的过程中我害你被抓了"
    },
    {
      "start": 43.27999999999997,
      "end": 45.0,
      "text": "我就会难过你知道吗"
    },
    {
      "start": 45.460000000000036,
      "end": 47.059999999999945,
      "text": "我会很有心理压力"
    },
    {
      "start": 47.059999999999945,
      "end": 48.25999999999999,
      "text": "我无理我做不到"
    },
    {
      "start": 48.25999999999999,
      "end": 50.07999999999993,
      "text": "然后这个事情最好笑的是什么朋友们"
    },
    {
      "start": 50.07999999999993,
      "end": 51.399999999999864,
      "text": "并不是游戏体验"
    },
    {
      "start": 51.8599999999999,
      "end": 54.039999999999964,
      "text": "我跟咩栗老师玩了这么几把之后呢"
    },
    {
      "start": 54.039999999999964,
      "end": 55.13999999999987,
      "text": "因为他们那个小群"
    },
    {
      "start": 55.13999999999987,
      "end": 56.700000000000045,
      "text": "当时是专门玩第五人格的"
    },
    {
      "start": 56.700000000000045,
      "end": 57.74000000000001,
      "text": "重点来了朋友们"
    },
    {
      "start": 57.74000000000001,
      "end": 59.319999999999936,
      "text": "今天正好跟你们说个八卦"
    },
    {
      "start": 60.25999999999999,
      "end": 61.299999999999955,
      "text": "我说了那会儿"
    },
    {
      "start": 61.299999999999955,
      "end": 63.09999999999991,
      "text": "我跟咩栗老师没有那么的熟悉"
    },
    {
      "start": 63.09999999999991,
      "end": 64.5,
      "text": "就只是单纯停留在一个"
    },
    {
      "start": 64.5,
      "end": 66.55999999999995,
      "text": "好友的关系"
    },
    {
      "start": 66.55999999999995,
      "end": 68.29999999999995,
      "text": "大家随便偶尔聊一聊"
    },
    {
      "start": 68.29999999999995,
      "end": 68.96000000000004,
      "text": "他可能就是"
    },
    {
      "start": 69.44000000000005,
      "end": 70.29999999999995,
      "text": "没事干了"
    },
    {
      "start": 70.29999999999995,
      "end": 71.29999999999995,
      "text": "翻开自己的列表"
    },
    {
      "start": 71.29999999999995,
      "end": 72.77999999999997,
      "text": "这个人在线聊两句"
    },
    {
      "start": 72.77999999999997,
      "end": 74.17999999999984,
      "text": "正好来一起打个游戏"
    },
    {
      "start": 74.17999999999984,
      "end": 75.09999999999991,
      "text": "我很喜欢这个游戏"
    },
    {
      "start": 75.09999999999991,
      "end": 76.03999999999996,
      "text": "所以来玩对不对"
    },
    {
      "start": 76.03999999999996,
      "end": 77.31999999999994,
      "text": "然后某一天"
    },
    {
      "start": 77.31999999999994,
      "end": 78.3599999999999,
      "text": "那个游戏我不怎么玩"
    },
    {
      "start": 78.3599999999999,
      "end": 80.07999999999993,
      "text": "我就给他开了一个免打扰"
    },
    {
      "start": 80.07999999999993,
      "end": 81.15999999999985,
      "text": "我就不怎么看"
    },
    {
      "start": 81.15999999999985,
      "end": 82.98000000000002,
      "text": "偶尔如果说咩栗在里面艾特我的话"
    },
    {
      "start": 82.98000000000002,
      "end": 84.17999999999984,
      "text": "我可能会进去看一眼"
    },
    {
      "start": 84.17999999999984,
      "end": 85.11999999999989,
      "text": "结果呢"
    },
    {
      "start": 85.11999999999989,
      "end": 86.51999999999998,
      "text": "过了很久一段时间"
    },
    {
      "start": 86.51999999999998,
      "end": 87.3599999999999,
      "text": "因为我没有找完"
    },
    {
      "start": 87.3599999999999,
      "end": 88.17999999999984,
      "text": "他也没有来找我了"
    },
    {
      "start": 88.17999999999984,
      "end": 89.03999999999996,
      "text": "我就想说他可能也不是"
    },
    {
      "start": 89.03999999999996,
      "end": 90.48000000000002,
      "text": "可能也不想跟我玩这个游戏"
    },
    {
      "start": 90.48000000000002,
      "end": 91.33999999999992,
      "text": "突然某一天"
    },
    {
      "start": 91.33999999999992,
      "end": 92.70000000000005,
      "text": "他来给我发了个私信说"
    },
    {
      "start": 93.83999999999992,
      "end": 94.96000000000004,
      "text": "那个群里退了吧"
    },
    {
      "start": 95.67999999999984,
      "end": 96.41999999999985,
      "text": "我说怎么了"
    },
    {
      "start": 98.22000000000003,
      "end": 99.46000000000004,
      "text": "他说我们吵架了"
    },
    {
      "start": 99.46000000000004,
      "end": 100.83999999999992,
      "text": "那个群已经散了"
    },
    {
      "start": 100.83999999999992,
      "end": 103.15999999999985,
      "text": "那个群主现跟我们已经不是朋友了"
    },
    {
      "start": 103.15999999999985,
      "end": 104.70000000000005,
      "text": "我点进去一看"
    },
    {
      "start": 104.70000000000005,
      "end": 106.46000000000004,
      "text": "上面吵架你知道吗"
    },
    {
      "start": 106.8599999999999,
      "end": 109.24000000000001,
      "text": "咩栗跟他的另一个小团体退了"
    },
    {
      "start": 109.24000000000001,
      "end": 110.61999999999989,
      "text": "把我留在了里面"
    },
    {
      "start": 110.61999999999989,
      "end": 111.20000000000005,
      "text": "我靠"
    },
    {
      "start": 112.05999999999995,
      "end": 113.5,
      "text": "我谁都不认识"
    },
    {
      "start": 113.5,
      "end": 114.55999999999995,
      "text": "所以没有人踹我"
    },
    {
      "start": 114.55999999999995,
      "end": 116.15999999999985,
      "text": "他们好像是被踹出去的"
    },
    {
      "start": 116.15999999999985,
      "end": 117.29999999999995,
      "text": "但因为我谁都不认识"
    },
    {
      "start": 117.29999999999995,
      "end": 118.53999999999996,
      "text": "所以我还在里面待着"
    },
    {
      "start": 118.96000000000004,
      "end": 120.39999999999986,
      "text": "但是我不熟啊"
    },
    {
      "start": 120.39999999999986,
      "end": 121.77999999999997,
      "text": "我一了解才知道"
    },
    {
      "start": 121.77999999999997,
      "end": 122.8599999999999,
      "text": "他们吵架了"
    },
    {
      "start": 122.8599999999999,
      "end": 123.98000000000002,
      "text": "他们闹掰了"
    },
    {
      "start": 124.51999999999998,
      "end": 125.75999999999999,
      "text": "然后他们一群人"
    },
    {
      "start": 125.75999999999999,
      "end": 126.39999999999986,
      "text": "出走的时候"
    },
    {
      "start": 126.87999999999988,
      "end": 128.46000000000004,
      "text": "把我这个陌生人"
    },
    {
      "start": 128.46000000000004,
      "end": 130.17999999999984,
      "text": "遗忘在了那个群里面"
    },
    {
      "start": 133.98000000000002,
      "end": 134.77999999999997,
      "text": "我去"
    },
    {
      "start": 136.07999999999993,
      "end": 137.01999999999998,
      "text": "很莫名"
    },
    {
      "start": 137.01999999999998,
      "end": 138.65999999999985,
      "text": "我感觉是真的被做局了"
    },
    {
      "start": 138.65999999999985,
      "end": 140.13999999999987,
      "text": "怎么会发生这样的事情"
    }
  ]
}